# Copy to ~/.autosymph/config/local.env for local-only startup defaults.
# autosymph loads this before config discovery. Shell environment variables win.

AUTOSYMPH_CONFIG_DIR=~/.autosymph/config
LINEAR_API_KEY=lin_api_replace_me

# Optional monitor endpoint override. Usually autosymph writes
# ~/.autosymph/status-api.json automatically, so this is not needed.
# AUTOSYMPH_STATUS_URL=http://127.0.0.1:4200

